# Copy this file to ".env" (same folder) and fill it in; ".env" itself is git-ignored, so real settings never get
# committed. DB_PASSWORD below must match whatever you put in place of CHANGE_ME_DB_PASSWORD in schema.sql.

DB_HOST=localhost
DB_PORT=3306
DB_USER=wedding_rsvp
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=wedding_rsvp

# The port this API server listens on (3001 was already taken by another local project, hence 3010).
PORT=3010

# Who is allowed to call this API from a browser, comma-separated. localhost and any private network address
# (192.168.x.x etc. - a phone testing over the same Wi-Fi) are already allowed automatically while building the site
# (see PRIVATE_HOST in index.js), so this only needs the site's real address once it is published, e.g.
# ALLOWED_ORIGINS=https://your-wedding-site.example
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300,http://localhost:4400
