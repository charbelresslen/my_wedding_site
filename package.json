{
  "name": "wedding-site",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "assets:manifest": "node tools/make-asset-manifest.mjs",
    "prestart": "npm run assets:manifest",
    "start": "ng serve",
    "prestart:vm": "npm run assets:manifest",
    "start:vm": "ng serve --configuration production --port 4500 --host 0.0.0.0",
    "prebuild": "npm run assets:manifest",
    "build": "ng build",
    "prewatch": "npm run assets:manifest",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run assets:manifest",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
